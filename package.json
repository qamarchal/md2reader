{
    "name": "md2reader",
    "displayName": "md2reader",
    "description": "Markdown to epub/mobi converter",
    "version": "0.8.0",
    "publisher": "gdrtf",
    "engines": {
        "vscode": "^1.10.0"
    },
    "keywords": [
        "Markdown",
        "Convert",
        "EPUB",
        "MOBI"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/gdrtf/md2reader.git"
    },
    "categories": [
        "Other"
    ],
    "activationEvents": [
        "onCommand:md2reader.convertFile",
        "onCommand:md2reader.convertDirectory",
        "onCommand:md2reader.convertWorkspace"
    ],
    "main": "./out/src/extension",
    "contributes": {
        "commands": [
            {
                "command": "md2reader.convertFile",
                "title": "Convert Current Markdown File to EPUB/MOBI"
            },
            {
                "command": "md2reader.convertDirectory",
                "title": "Convert Current Directory Markdown to EPUB/MOBI"
            },
            {
                "command": "md2reader.convertWorkspace",
                "title": "Convert Workspace Markdown to EPUB/MOBI"
            }
        ],
        "configuration": {
            "title": "md2reader configuration",
            "properties": {
                "md2reader.outputDir": {
                    "title": "Output directory",
                    "description": "This path may be absolute or relative to the workspace",
                    "type": "string",
                    "default": "."
                },
                "md2reader.workingDir": {
                    "title": "Working directory",
                    "description": "This path may only be relative to the workspace",
                    "type": "string",
                    "default": "."
                },
                "md2reader.cssFile": {
                    "title": "CSS file",
                    "type": "string",
                    "default": null
                },
                "md2reader.singleOutput": {
                    "title": "Convert to a single epub/mobi file",
                    "type": "boolean",
                    "default": false
                },
                "md2reader.outputFile": {
                    "title": "Name of the epub/mobi file",
                    "description": "Only if md2reader.single is true",
                    "type": "string",
                    "default": "Untitled"
                },
                "md2reader.recurse": {
                    "title": "Include subfolders",
                    "type": "boolean",
                    "default": false
                },
                "md2reader.type": {
                    "title": "Conversion types",
                    "description": "This parameter can be a single or a set of conversion types (\"epub\", \"mobi\", or [\"epub\", \"mobi\"])",
                    "default": [
                        "epub"
                    ],
                    "oneOf": [
                        {
                            "type": "string",
                            "enum": [
                                "epub",
                                "mobi"
                            ]
                        },
                        {
                            "type": "array",
                            "uniqueItems": true,
                            "items": {
                                "type": "string",
                                "enum": [
                                    "epub",
                                    "mobi"
                                ]
                            }
                        }
                    ]
                },
                "md2reader.pandocFile": {
                    "title": "Pandoc executable file",
                    "description": "Path to the pandoc executable",
                    "type": "string",
                    "default": "pandoc"
                },
                "md2reader.kindlegenFile": {
                    "title": "Kindlegen executable file",
                    "description": "Path to the kindlegen executable",
                    "type": "string",
                    "default": "kindlegen"
                },
                "md2reader.pandocArgs": {
                    "title": "Additional Pandoc arguments",
                    "description": "Additional command-line arguments passed to pandoc (e.g. [\"--toc\"])",
                    "type": "array",
                    "default": [],
                    "items": {
                        "type": "string"
                    }
                }
            }
        }
    },
    "scripts": {
        "vscode:prepublish": "tsc -p ./",
        "compile": "tsc -watch -p ./",
        "postinstall": "node ./node_modules/vscode/bin/install",
        "test": "node ./node_modules/vscode/bin/test"
    },
    "devDependencies": {
        "@types/mkdirp": "^0.5.2",
        "@types/mocha": "^2.2.32",
        "@types/node": "^16.18.126",
        "@types/temp": "^0.8.34",
        "mocha": "^2.3.3",
        "typescript": "^4.9.5",
        "vscode": "^1.0.0"
    },
    "dependencies": {
        "mkdirp": "^0.5.1",
        "temp": "^0.8.3"
    }
}
